rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny: anything not explicitly matched below is inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin authority comes from a custom claim minted server-side by
    // scripts/set-admin-claim.mjs and carried in the signed ID token. A client
    // cannot set it. Keep this in exact lockstep with isAdminClaim() in
    // src/lib/adminClaim.ts — both require a literal boolean true.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ---- QA refinement batches (admin-only) ----------------------------
    // Batches hold question IDs and workflow state ONLY. Production question
    // content stays in content/questions/**.json and is never copied here, so
    // this collection can never become a second source of truth for questions.
    match /refinementBatches/{batchId} {
      function isValidBatchPayload() {
        return request.resource.data.keys().hasOnly(
             ['id', 'title', 'family', 'subject', 'status', 'sequence',
              'questionIds', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && request.resource.data.id == batchId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.family is string
        && request.resource.data.family.size() > 0
        && request.resource.data.family.size() <= 200
        && request.resource.data.status in
             ['needs-content', 'builder', 'ready-for-qa', 'frozen']
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && request.resource.data.questionIds is list
        && request.resource.data.questionIds.size() > 0
        && request.resource.data.questionIds.size() <= 200
        && (!('subject' in request.resource.data)
            || request.resource.data.subject in
                 ['Numerical Reasoning', 'Analytical Reasoning', 'Verbal Ability',
                  'Clerical Ability', 'General Information'])
        && (!('sequence' in request.resource.data)
            || (request.resource.data.sequence is int
                && request.resource.data.sequence > 0))
        && (!('updatedAt' in request.resource.data)
            || (request.resource.data.updatedAt is string
                && request.resource.data.updatedAt.size() <= 40))
        && (!('createdBy' in request.resource.data)
            || request.resource.data.createdBy == null
            || (request.resource.data.createdBy is string
                && request.resource.data.createdBy.size() <= 128))
        && (!('updatedBy' in request.resource.data)
            || request.resource.data.updatedBy == null
            || (request.resource.data.updatedBy is string
                && request.resource.data.updatedBy.size() <= 128));
      }

      allow read: if isAdmin();
      allow create: if isAdmin()
        && isValidId(batchId)
        && isValidBatchPayload();
      // The batch identity and its creation record are fixed once written;
      // status, membership, and title are what the workflow edits.
      allow update: if isAdmin()
        && isValidId(batchId)
        && isValidBatchPayload()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // ---- Feedback (bug reports / feature requests) ---------------------
    // Create-only for signed-in users; nobody can read, edit, or delete
    // through the client. Review happens in the Firebase console.
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'category', 'message', 'createdAt', 'appVersion'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in ['bug', 'feature', 'general']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && (request.resource.data.email == null
            || (request.resource.data.email is string
                && request.resource.data.email.size() <= 320))
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 50;
      allow read, update, delete: if false;
    }

    // ---- User profile -------------------------------------------------
    match /users/{userId} {
      function isValidProfilePayload() {
        return request.resource.data.keys().hasOnly(
             ['uid', 'displayName', 'email', 'isAnonymous',
              'preferredExamLevel', 'createdAt', 'updatedAt'])
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == userId)
        && (!('preferredExamLevel' in request.resource.data)
            || request.resource.data.preferredExamLevel in ['Professional', 'Subprofessional'])
        && (!('displayName' in request.resource.data)
            || request.resource.data.displayName == null
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 100))
        && (!('email' in request.resource.data)
            || request.resource.data.email == null
            || (request.resource.data.email is string
                && request.resource.data.email.size() <= 320));
      }

      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidProfilePayload();
      // Same payload gates as create, plus: the account-creation timestamp
      // is immutable once written.
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidProfilePayload()
        && (!('createdAt' in resource.data)
            || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if false;

      // ---- Attempt history --------------------------------------------
      match /attempts/{attemptId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(attemptId)
          && request.resource.data.mode in ['simulation', 'practice']
          && request.resource.data.examLevel in ['Professional', 'Subprofessional']
          && request.resource.data.questionCount is int
          && request.resource.data.questionCount > 0
          && request.resource.data.questionCount <= 200
          && request.resource.data.correctCount is int
          && request.resource.data.correctCount >= 0
          && request.resource.data.correctCount <= request.resource.data.questionCount
          && request.resource.data.percentage is number
          && request.resource.data.percentage >= 0
          && request.resource.data.percentage <= 100
          && request.resource.data.passed is bool
          && request.resource.data.durationSeconds is int
          && request.resource.data.durationSeconds >= 0
          && request.resource.data.startedAt is number
          && request.resource.data.completedAt is number
          && request.resource.data.subjects is list
          && request.resource.data.subjects.size() <= 5
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 200;
        // Attempts are immutable records of a completed exam.
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }
  }
}
