rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny: anything not explicitly matched below is inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ---- Feedback (bug reports / feature requests) ---------------------
    // Create-only for signed-in users; nobody can read, edit, or delete
    // through the client. Review happens in the Firebase console.
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'category', 'message', 'createdAt', 'appVersion'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in ['bug', 'feature', 'general']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && (request.resource.data.email == null
            || (request.resource.data.email is string
                && request.resource.data.email.size() <= 320))
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 50;
      allow read, update, delete: if false;
    }

    // ---- User profile -------------------------------------------------
    match /users/{userId} {
      function isValidProfilePayload() {
        return request.resource.data.keys().hasOnly(
             ['uid', 'displayName', 'email', 'isAnonymous',
              'preferredExamLevel', 'createdAt', 'updatedAt'])
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == userId)
        && (!('preferredExamLevel' in request.resource.data)
            || request.resource.data.preferredExamLevel in ['Professional', 'Subprofessional'])
        && (!('displayName' in request.resource.data)
            || request.resource.data.displayName == null
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 100))
        && (!('email' in request.resource.data)
            || request.resource.data.email == null
            || (request.resource.data.email is string
                && request.resource.data.email.size() <= 320));
      }

      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidProfilePayload();
      // Same payload gates as create, plus: the account-creation timestamp
      // is immutable once written.
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidProfilePayload()
        && (!('createdAt' in resource.data)
            || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if false;

      // ---- Attempt history --------------------------------------------
      match /attempts/{attemptId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(attemptId)
          && request.resource.data.mode in ['simulation', 'practice']
          && request.resource.data.examLevel in ['Professional', 'Subprofessional']
          && request.resource.data.questionCount is int
          && request.resource.data.questionCount > 0
          && request.resource.data.questionCount <= 200
          && request.resource.data.correctCount is int
          && request.resource.data.correctCount >= 0
          && request.resource.data.correctCount <= request.resource.data.questionCount
          && request.resource.data.percentage is number
          && request.resource.data.percentage >= 0
          && request.resource.data.percentage <= 100
          && request.resource.data.passed is bool
          && request.resource.data.durationSeconds is int
          && request.resource.data.durationSeconds >= 0
          && request.resource.data.startedAt is number
          && request.resource.data.completedAt is number
          && request.resource.data.subjects is list
          && request.resource.data.subjects.size() <= 5
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 200;
        // Attempts are immutable records of a completed exam.
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }
  }
}
