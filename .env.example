# Firebase web app configuration (Project Settings → General → Your apps)
# Firebase web config values identify your project to Google's SDK; access is
# governed by Firestore Security Rules and Firebase Auth, not by hiding these.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
# Optional: non-default Firestore database id (leave empty for "(default)")
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Optional, development only: point Firebase Auth at the local emulator, e.g.
# 127.0.0.1:9099. Used to rehearse the admin custom-claim bootstrap without
# touching a real project or account (docs/admin/ADMIN_ACCESS.md). Ignored in
# production builds — src/lib/firebase.ts also gates it on import.meta.env.DEV.
VITE_FIREBASE_AUTH_EMULATOR_HOST=
