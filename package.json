{
  "name": "acecse",
  "description": "AceCSE \u2014 Philippine Civil Service Examination simulator. Simulation first, learning second.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "validate:questions": "node scripts/validate-questions.mjs && node scripts/validate-taxonomy.mjs && node scripts/validate-filing.mjs && node scripts/validate-spelling.mjs",
    "validate:taxonomy": "node scripts/validate-taxonomy.mjs",
    "validate:filing": "node scripts/validate-filing.mjs",
    "validate:spelling": "node scripts/validate-spelling.mjs",
    "test:content-model": "node scripts/test-content-model.mjs",
    "test:engine": "vitest run src/lib/examEngine.test.ts",
    "test:booklet": "vitest run src/lib/examViewModel.test.ts src/components/shell/BookletExamLayout.test.tsx",
    "test": "vitest run",
    "audit:content": "node scripts/audit-content.mjs"
  },
  "dependencies": {
    "firebase": "^12.17.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  }
}